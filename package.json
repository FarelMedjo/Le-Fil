{
  "name": "le-fil",
  "version": "0.1.0",
  "private": true,
  "description": "TutorLab — « Exercice 3 » : spot de 60 s (9:16) en plan-séquence au-dessus de la table familiale, rendu image par image, avec sa bande-son synthétisée, sa version courte de 30 s, sa variante de 64 s, son adaptation 16:9 et sa version anglaise.",
  "type": "module",
  "scripts": {
    "audio": "node scripts/build-audio.mjs",
    "audio:en": "node scripts/build-audio.mjs --en",
    "dev": "node scripts/serve.mjs",
    "glyphs": "node scripts/build-glyphs.mjs",
    "render": "node scripts/render.mjs",
    "render:en": "node scripts/render.mjs --lang en",
    "render:light": "node scripts/render.mjs --size 720x1280",
    "render:30s": "node scripts/render.mjs --cut 30s --size 720x1280",
    "render:64s": "node scripts/render.mjs --cut 64s",
    "render:90s": "node scripts/render.mjs --cut 90s",
    "render:16x9": "node scripts/render.mjs --format 16:9",
    "stills": "node scripts/render.mjs --stills",
    "storyboard": "node scripts/storyboard.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "hersheytext": "^2.0.0",
    "playwright": "1.56.1"
  }
}
